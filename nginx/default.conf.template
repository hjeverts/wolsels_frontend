# nginx in de frontend-container: serveert de Angular-app en stuurt /api/ door naar de backend.
# Staat achter de nginx op de server (TLS); die proxyt alles naar deze container.

# Een meegestuurd X-Forwarded-Proto (van de nginx op de server) doorgeven, anders het eigen schema.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    # Foto's (al verkleind door de browser) plus miniatuur; de backend begrenst zelf op ±2,3 MB.
    client_max_body_size 4m;

    # Echte client-IP alleen overnemen van proxies op interne netwerken (de nginx op de server bereikt
    # de container via het Docker-netwerk). Een bezoeker die rechtstreeks verbindt kan zo geen IP vervalsen
    # om de pogingslimieten te omzeilen.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header X-Forwarded-For;

    # Beveiligingsheaders. Let op: een add_header in een location vervangt deze allemaal, daarom regelen de
    # locations hieronder caching met 'expires' in plaats van add_header.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Backend-naam steeds opnieuw opzoeken, zodat een herstarte backend met een nieuw IP bereikbaar blijft.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Alleen het vastgestelde client-IP doorgeven, niet de (vervalsbare) keten van de bezoeker.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 60s;
    }

    # JS- en CSS-bestandsnamen bevatten een hash; ze mogen lang gecachet worden.
    location ~* \.(?:js|css|woff2?)$ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    # Iconen en manifest hebben vaste namen: korter cachen, zodat een nieuw icoon wel aankomt.
    location ~* \.(?:ico|svg|png|webp)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    # Web-app-manifest (installeren op tablet/telefoon) met het juiste MIME-type.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        expires 7d;
        try_files $uri =404;
    }

    # Angular-routes (bv. /mengsels/3) altijd naar index.html; die zelf niet cachen.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html =404;
    }
}
