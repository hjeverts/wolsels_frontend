# nginx in the frontend container: serves the Angular app and forwards /api/ to the backend.
# Sits behind the nginx on the server (TLS), which proxies everything to this container.

# Pass on an incoming X-Forwarded-Proto (from the nginx on the server), otherwise our own scheme.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Search engines. SITE_INDEXABLE=true (only for the public installation with PUBLIC_URL set) serves a robots.txt
# that allows the landing page and the account pages, plus a sitemap. Otherwise everything is closed off:
# robots.txt disallows all, there is no sitemap and every response carries X-Robots-Tag: noindex.
map "${SITE_INDEXABLE}" $robots_txt {
    "true" "User-agent: *
Disallow: /api/
Disallow: /voorraad
Disallow: /mengsels
Disallow: /productie
Disallow: /dieren
Disallow: /locaties
Disallow: /account
Disallow: /huishouden
Disallow: /beheer
Disallow: /uitnodiging/
Disallow: /wachtwoord-
Allow: /

Sitemap: ${PUBLIC_URL}/sitemap.xml
";
    default "User-agent: *
Disallow: /
";
}

map "${SITE_INDEXABLE}" $robots_tag {
    "true"  "";
    default "noindex, nofollow";
}

# The landing page (index.html, prerendered at build time) is for visitors. With a session cookie '/' serves the
# app shell straight away, so a logged-in user goes on to the stock without seeing the landing page first.
map $http_cookie $start_page {
    "~(^|;)\s*wolsels\.auth=" /index.csr.html;
    default                    /index.html;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    # Photos (already resized by the browser) plus thumbnail; the backend itself limits to ±2.3 MB.
    client_max_body_size 4m;

    # Only take the real client IP from proxies on internal networks (the nginx on the server reaches
    # the container via the Docker network). That way a visitor connecting directly cannot forge an IP
    # to get around the attempt limits.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header X-Forwarded-For;

    # Security headers. Note: an add_header in a location replaces all of these, which is why the
    # locations below handle caching with 'expires' instead of add_header.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Robots-Tag $robots_tag always;

    # The prerendered landing page contains this placeholder for the public address (canonical link, link
    # preview image); fill in the address of this installation.
    sub_filter 'https://wolsels.invalid' '${PUBLIC_URL}';
    sub_filter_once off;

    # Resolve the backend name each time, so that a restarted backend with a new IP stays reachable.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    # ^~: never treat API paths as files (the regex locations below).
    location ^~ /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Only pass on the established client IP, not the visitor's (forgeable) chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 60s;
    }

    # JS and CSS file names contain a hash; they may be cached for a long time.
    location ~* \.(?:js|css|woff2?)$ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    # Icons and manifest have fixed names: cache them shorter, so that a new icon does arrive.
    location ~* \.(?:ico|svg|png|webp)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    # Web app manifest (install on tablet/phone) with the right MIME type.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        expires 7d;
        try_files $uri =404;
    }

    location = /robots.txt {
        default_type text/plain;
        expires 1d;
        return 200 $robots_txt;
    }

    location = /sitemap.xml {
        if ($robots_tag) {
            return 404;
        }
        default_type application/xml;
        expires 1d;
        return 200 '<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>${PUBLIC_URL}/</loc></url>
  <url><loc>${PUBLIC_URL}/registreren</loc></url>
  <url><loc>${PUBLIC_URL}/inloggen</loc></url>
</urlset>
';
    }

    # Any other file that does not exist (e.g. /wp-login.php) is a real 404, not the app with status 200.
    location ~ \.[A-Za-z0-9]+$ {
        try_files $uri =404;
    }

    # Landing page for visitors, the app for logged-in users (see $start_page above).
    location = / {
        expires -1;
        try_files $start_page =404;
    }

    # Angular routes (e.g. /mengsels/3) always to the app shell; don't cache that file itself.
    location / {
        expires -1;
        try_files $uri $uri/ /index.csr.html =404;
    }
}
